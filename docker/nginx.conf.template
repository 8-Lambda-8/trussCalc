server {
    listen 80;
    listen [::]:80;
    server_name _;

    root /usr/share/nginx/html;

    location = / {
        return 302 ${APP_SUBPATH}/;
    }

    location = ${APP_SUBPATH} {
        return 301 ${APP_SUBPATH}/;
    }

    location ${APP_SUBPATH}/assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location ${APP_SUBPATH}/ {
        try_files $uri $uri/ ${APP_SUBPATH}/index.html;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }
}
